# Google Cloud Vertex AI Configuration (Option B)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=northamerica-northeast1
GOOGLE_CLOUD_REGION=northamerica-northeast1

# Alternative Option A (Google AI Studio direct API key)
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Cat actor tuning -------------------------------------------------------
# Thinking budget: tokens of private scratchpad the tactical actor gets before
# it must commit to an action. 0 disables it (the original reflex behaviour, and
# the setting the schema's thought-before-action field order was measured under),
# -1 lets the model decide, or a token count within the model's range (1-24576
# for Gemini 2.5 Flash).
# Also adjustable live in the workbench (Box 2) and via /api/agent/thinking-budget.
# CAT_THINKING_BUDGET=512

# How long one decision may run before it is abandoned and the reflex heuristic
# plays the tick. Coupled to the budget above: thinking tokens are emitted before
# the first answer token, so ~8s affords only ~1,300 tokens of thought. Raising
# the budget without raising this produces a run that measures the heuristic.
# CAT_DELIBERATION_TIMEOUT_SEC=8

# --- Coach / evaluator tuning ------------------------------------------------
# The coach is a separate agent with its own independent dial, so an experiment
# on one does not silently move the other. It runs once every few hundred ticks
# off the tick loop rather than four times a second, so tokens are far cheaper
# here than they are for the actor -- but it reasons over a whole transcript
# instead of a single frame, which is the workload a scratchpad actually helps.
# Also adjustable live in the workbench (Box 6) and via
# /api/agent/evaluator/thinking-budget.
# CAT_EVAL_THINKING_BUDGET=4096

# How long one review may run before it is abandoned. Clamped to 30-900s. The
# 30s floor is not arbitrary: the coach's get_boxscore tool carries its own 3s
# timeout, and the review window has to stay an order of magnitude above it or a
# single slow box score could consume the entire review.
#
# Note this failure is worse than the actor's. When the actor overruns it loses
# one tick to the reflex. When the coach overruns, evaluate() falls back to a
# positional summary -- bounding boxes and blind directions -- and publishes that
# OVER the real standing orders in coaching_notes.md, so the cat then plays the
# next few hundred ticks on filler. Raise this together with the budget above.
# CAT_EVAL_TIMEOUT_SEC=60
